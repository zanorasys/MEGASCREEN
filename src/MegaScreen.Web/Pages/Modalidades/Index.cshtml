@page
@model MegaScreen.Web.Pages.Modalidades.IndexModel
@{ViewData["Title"]="Modalidades";}
<div class="page-head"><div><h2>Modalidades de Atendimento</h2><p>Tipos de serviço e sua prioridade interna.</p></div></div>
<div class="cfg-grid"><div class="card"><div class="card-head"><h2>@(Model.Item.Id==0?"Nova modalidade":"Editar modalidade")</h2></div><form method="post" asp-page-handler="Save" class="form-pad"><input asp-for="Item.Id" type="hidden">
<div class="field"><label>Modalidade</label><input asp-for="Item.Nome"></div><div class="field"><label>Prefixo</label><input asp-for="Item.Prefixo" maxlength="3"></div><div class="field"><label>Prioridade interna</label><select asp-for="Item.PrioridadeInterna" asp-items="Html.GetEnumSelectList<Prioridade>()"></select></div><label class="check"><input asp-for="Item.Ativa"> Ativa</label><div asp-validation-summary="All" class="validation"></div><div style="margin-top:14px"><button class="btn pri-btn2">Salvar</button>@if(Model.Item.Id>0){<a class="btn line" asp-page="./Index">Cancelar</a>}</div></form></div>
<div class="card"><div class="table-wrap"><table><thead><tr><th>Modalidade</th><th>Prefixo</th><th>Prioridade</th><th>Status</th><th></th></tr></thead><tbody>@if(Model.Itens.Count==0){<tr class="empty-row"><td colspan="5">Nenhuma modalidade cadastrada.</td></tr>}@foreach(var m in Model.Itens){<tr><td class="nm">@m.Nome</td><td><span class="senha-chip">@m.Prefixo</span></td><td>@m.PrioridadeInterna</td><td><span class="st @(m.Ativa?"on":"off")">@(m.Ativa?"Ativa":"Inativa")</span></td><td><div class="rowacts"><a class="iconbtn" asp-route-edit="@m.Id" title="Editar">✎</a><form method="post" asp-page-handler="Delete" asp-route-id="@m.Id" onsubmit="return confirm('Excluir esta modalidade?')"><button class="iconbtn" title="Excluir">×</button></form></div></td></tr>}</tbody></table></div></div></div>