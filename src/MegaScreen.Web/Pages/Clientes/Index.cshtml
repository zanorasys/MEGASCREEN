@page
@model MegaScreen.Web.Pages.Clientes.IndexModel
@{ ViewData["Title"] = "Gestão de Clientes"; }
<div class="page-head"><div><h2>Gestão de Clientes <span class="pri alta">White Label</span></h2><p>Clientes PJ/PF e gestão de senhas por cliente.</p></div><div class="spacer"></div><button class="btn pri-btn2">Novo cliente</button></div>
<div class="card"><table><thead><tr><th>Cliente</th><th>Tipo</th><th>Documento</th><th>Filiais</th><th>Status</th></tr></thead><tbody>
@foreach (var c in Model.Itens) { <tr><td class="nm">@c.Nome</td><td><span class="badge-type tv">@c.Tipo</span></td><td>@c.Documento</td><td>@c.Filiais.Count</td><td><span class="st @(c.Ativo ? "on" : "off")">@(c.Ativo ? "Ativo" : "Suspenso")</span></td></tr> }
</tbody></table></div>
