@page
@model MegaScreen.Web.Pages.Ajuda.IndexModel
@{ ViewData["Title"] = "Ajuda"; }
<div class="page-head"><div><h2>Ajuda / Documentação</h2><p>Orientações para configuração inicial e explicação dos elementos.</p></div></div>
<div class="acc">
    <details open><summary>Primeiros passos</summary><div class="accbody">Cadastre as Salas de Espera, associe as Telas (TV/Tablet) e defina as Modalidades. Depois configure os usuários e o Local Atual.</div></details>
    <details><summary>Telas</summary><div class="accbody">Monitores de exibição: TV (horizontal) ou Tablet (vertical), com prédio, andar, ramal e cor.</div></details>
    <details><summary>Modalidades e prioridades</summary><div class="accbody">Cada modalidade tem prefixo e prioridade interna. Prioridades gerais: normal, idoso e prioridade.</div></details>
</div>
