@page
@model MegaScreen.Web.Pages.Public.ProfissionalModel
@{ Layout = "_LayoutPublic"; ViewData["Title"] = "Profissional"; }
<div class="prof active">
    <div class="prof-top">
        <div class="mk"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#fff" stroke-width="2.2"><path d="M12 3v6M9 6h6"/><rect x="4" y="9" width="16" height="11" rx="2"/></svg></div>
        <div><h1>Painel do Profissional<small>@User.Identity?.Name · <span id="profSalaNome"></span></small></h1></div>
        <div class="spacer" style="margin-left:auto"></div>
        <a class="btn line sm" asp-page="/Painel/Index">Voltar ao backoffice</a>
    </div>
    <div class="prof-wrap">
        <div class="prof-current" id="profCurrent">
            <div class="lbl">Atendendo agora</div><div class="big" id="profSenha">—</div><div class="who" id="profNome">Nenhum paciente</div><div class="tags" id="profTags"></div>
            <div class="prof-actions">
                <button class="bigbtn call" id="profCall">Chamar próximo</button>
                <button class="bigbtn recall" id="profRecall">Rechamar</button>
                <button class="bigbtn done" id="profDone">Concluir</button>
                <button class="bigbtn miss" id="profMiss">Não compareceu</button>
            </div>
        </div>
        <div class="prof-side">
            <div class="prof-room"><label>Sala de atendimento</label><select id="profRoom">@foreach (var s in Model.Salas) { <option value="@s.Id" data-nome="@s.Nome">@s.Nome — @s.Predio · @s.Andar · R.@s.Ramal</option> }</select></div>
            <div class="card"><div class="card-head"><h2>Liberados pela recepção</h2><span class="rt"><span class="dot"></span>Ao vivo</span></div><div class="next-list" id="profNext"></div></div>
        </div>
    </div>
</div>
@section Scripts {
<script>
    const filialId=@Model.FilialId;
    let fila=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Fila));
    const esc=s=>(s||'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
    const sel=()=>profRoom.options[profRoom.selectedIndex];
    const salaNome=()=>sel()?.dataset.nome||'';
    // Lembra a sala escolhida neste navegador.
    try{const salva=localStorage.getItem('megaSalaProf');if(salva&&[...profRoom.options].some(o=>o.value===salva))profRoom.value=salva;}catch{}
    profRoom.onchange=()=>{try{localStorage.setItem('megaSalaProf',profRoom.value);}catch{}render();};
    // Paciente em atendimento NESTA sala (não o primeiro da filial).
    const atual=()=>fila.find(q=>q.status==='EmAtendimento'&&(q.ponto||'')===salaNome());
    // Só entra na fila do profissional quem já passou pela recepção (etapa Profissional):
    // primeiro os direcionados para esta sala, depois a fila geral. A ordem do servidor (prioridade + encaminhamento) é mantida.
    function filaDaSala(){
        const id=+profRoom.value||0;
        const liberados=fila.filter(q=>q.etapa==='Profissional'&&q.status==='Aguardando');
        return [...liberados.filter(q=>q.salaDestinoId===id),...liberados.filter(q=>q.salaDestinoId==null)];
    }
    async function post(url){try{const r=await fetch(url,{method:'POST'});if(r.ok)return;let m='Não foi possível concluir a ação.';try{const j=await r.json();if(j&&j.erro)m=j.erro;}catch{}if(r.status===401)m='Sua sessão expirou. Faça login novamente.';alert(m);}catch{alert('Sem conexão com o servidor.');}}
    function render(){
        profSalaNome.textContent=salaNome()||'Sem sala';
        const a=atual();
        profSenha.textContent=a?a.codigo:'—'; profNome.textContent=a?(a.nome||'—'):'Nenhum paciente';
        profTags.innerHTML=a?`<span>${esc(a.modalidade)}</span>${a.prioridade!=='Normal'?`<span class="pri">${a.prioridade==='Alta'?'Prioridade':esc(a.prioridade)}</span>`:''}`:'';
        const nxt=filaDaSala().slice(0,6);
        profNext.innerHTML=nxt.length?nxt.map((q,i)=>`<div class="next-item"><div class="o">${String(i+1).padStart(2,'0')}</div><span class="s">${esc(q.codigo)}</span><div class="nm2">${esc(q.nome||'—')}<small>${esc(q.modalidade)}</small></div>${q.salaDestinoId!=null?'<span class="tag-sala">Para esta sala</span>':''}</div>`).join(''):'<div class="next-empty">Nenhum paciente liberado pela recepção.</div>';
        profCall.disabled=!nxt.length;
    }
    async function chamarProximo(){if(!sel()){alert('Cadastre uma sala em Configuração > Salas.');return;}const n=filaDaSala()[0];if(!n){alert('Nenhum paciente liberado pela recepção.');return;}await post(`/api/senhas/chamar-profissional/${n.id}?salaId=${encodeURIComponent(profRoom.value)}`);}
    async function rechamar(){const a=atual();if(!a)return;await post(`/api/senhas/rechamar/${a.id}`);}
    async function concluir(){const a=atual();if(!a)return;await post(`/api/senhas/concluir/${a.id}`);}
    async function naoCompareceu(){const a=atual();if(!a)return;await post(`/api/senhas/status/${a.id}/4`);}
    profCall.onclick=chamarProximo; profRecall.onclick=rechamar; profDone.onclick=concluir; profMiss.onclick=naoCompareceu;
    const conn=new signalR.HubConnectionBuilder().withUrl('/hubs/senha').withAutomaticReconnect().build();
    conn.on('FilaAtualizada',f=>{fila=f;render();});
    conn.onreconnected(async()=>{await conn.invoke('EntrarNaFilial',filialId);try{const r=await fetch('/api/senhas/fila',{cache:'no-store'});if(r.ok){fila=await r.json();render();}}catch{}});
    conn.start().then(()=>conn.invoke('EntrarNaFilial',filialId)).catch(console.error);
    render();
</script>
}
