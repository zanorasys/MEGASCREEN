@page
@model MegaScreen.Web.Pages.Public.TvModel
@{ Layout = "_LayoutPublic"; ViewData["Title"] = "Painel TV"; }
<div class="public active">
    <div class="tv-top">
        <div class="mk"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="12" rx="2"/><path d="M9 20h6M8 16v4M16 16v4"/></svg></div>
        <div><h1>Sua Marca</h1><small>Recepção I</small></div>
        <div class="tvclock"><div class="t" id="tvClock">--:--</div><div class="d" id="tvToday"></div></div>
    </div>
    <div class="tv-body">
        <div class="tv-current" id="tvCurrent"><div class="lbl">Senha</div><div class="senha" id="tvSenha">—</div><div class="nm" id="tvNome">Aguardando</div><div class="sala" id="tvSala"></div></div>
        <div class="tv-side"><div class="sh">Últimas chamadas</div><div class="list" id="tvList"></div><div class="tv-media">Área de vídeo / publicidade</div></div>
    </div>
</div>
@section Scripts {
<script>
    const filialId = @Model.FilialId;
    let fila = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Fila));
    const esc = s => (s||'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
    function render(){
        const a = fila.find(q=>q.status==='EmAtendimento');
        tvSenha.textContent=a?a.codigo:'—'; tvNome.textContent=a?(a.nome||'—'):'Aguardando'; tvSala.textContent=a?(a.ponto||''):'';
        tvList.innerHTML=fila.slice(0,4).map(q=>`<div class="tv-row"><div class="s">${q.codigo}</div><div class="nn">${esc(q.nome||'—')}<small>${esc(q.modalidade)}</small></div><div class="sl">${esc(q.ponto||'')}</div></div>`).join('');
    }
    function tick(){ const d=new Date(); tvClock.textContent=String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0'); tvToday.textContent=d.toLocaleDateString('pt-BR',{weekday:'long',day:'numeric',month:'long'}); }
    tick(); setInterval(tick,10000);
    const conn=new signalR.HubConnectionBuilder().withUrl('/hubs/senha').withAutomaticReconnect().build();
    conn.on('FilaAtualizada',f=>{fila=f;render();});
    conn.on('SenhaChamada',()=>{tvCurrent.classList.remove('flash');void tvCurrent.offsetWidth;tvCurrent.classList.add('flash');});
    conn.start().then(()=>conn.invoke('EntrarNaFilial',filialId)).catch(console.error);
    render();
</script>
}
