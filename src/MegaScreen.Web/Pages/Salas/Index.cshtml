@page
@model MegaScreen.Web.Pages.Salas.IndexModel
@{
    ViewData["Title"] = "Salas";
    // Formulário começa recolhido; abre sozinho ao editar ou quando o POST volta com erro.
    var formAberto = Model.Item.Id > 0 || !ViewData.ModelState.IsValid || Request.Query.ContainsKey("novo");
}
<div class="page-head">
    <div><h2>Salas (destino de atendimento)</h2><p>Locais para onde a senha é encaminhada.</p></div>
    <button type="button" class="btn pri-btn2 sm spacer" data-abre-form="formSala">+ Nova sala</button>
</div>
<div class="stack">
    <div class="card form-collapse @(formAberto ? "" : "hidden")" id="formSala" data-editando="@(Model.Item.Id > 0 ? "1" : "0")">
        <div class="card-head"><h2>@(Model.Item.Id == 0 ? "Nova sala" : "Editar sala")</h2></div>
        <form method="post" asp-page-handler="Save" class="form-pad">
            <input asp-for="Item.Id" type="hidden">
            <div class="form2">
                <div class="field"><label>Nome</label><input asp-for="Item.Nome"></div>
                <div class="field"><label>Apelido</label><input asp-for="Item.Apelido"></div>
                <div class="field"><label>Prédio</label><input asp-for="Item.Predio"></div>
                <div class="field"><label>Andar</label><input asp-for="Item.Andar"></div>
                <div class="field"><label>Ramal</label><input asp-for="Item.Ramal"></div>
                <div class="field"><label>Cor</label><input asp-for="Item.Cor" type="color"></div>
                <div class="field full"><label>Sala de espera do paciente</label><select asp-for="Item.SalaEsperaId"><option value="">Todas (aparece em todas as TVs)</option>@foreach (var se in Model.SalasEspera){<option value="@se.Id">@se.Nome</option>}</select><small class="hint">Define em qual TV a chamada desta sala aparece.</small></div>
            </div>
            <div asp-validation-summary="All" class="validation"></div>
            <div class="form-acts">
                <button class="btn pri-btn2">Salvar</button>
                @if (Model.Item.Id > 0) {<a class="btn line" asp-page="./Index">Cancelar</a>}
                else {<button type="button" class="btn line" data-fecha-form="formSala">Cancelar</button>}
            </div>
        </form>
    </div>
    <div class="card"><table><thead><tr><th>ID</th><th>Nome</th><th>Apelido</th><th>Prédio / Andar</th><th>Ramal</th><th>Sala de espera</th><th>Cor</th><th></th></tr></thead><tbody>
    @if (Model.Itens.Count == 0) {<tr class="empty-row"><td colspan="8">Nenhuma sala cadastrada. Clique em "+ Nova sala".</td></tr>}
    @foreach (var s in Model.Itens)
    {
        <tr><td>#@s.Id.ToString("D2")</td><td class="nm">@s.Nome</td><td>@s.Apelido</td><td>@s.Predio · @s.Andar</td><td>@s.Ramal</td><td>@(Model.SalasEspera.FirstOrDefault(x => x.Id == s.SalaEsperaId)?.Nome ?? "Todas")</td><td><span class="swatch" style="background:@s.Cor"></span></td>
        <td><div class="rowacts"><a class="iconbtn" asp-route-edit="@s.Id" title="Editar">✎</a><form method="post" asp-page-handler="Delete" asp-route-id="@s.Id" onsubmit="return confirm('Excluir esta sala?')"><button class="iconbtn" title="Excluir">×</button></form></div></td></tr>
    }
    </tbody></table></div>
</div>
@section Scripts{
<script src="~/js/form-collapse.js" asp-append-version="true"></script>
}
