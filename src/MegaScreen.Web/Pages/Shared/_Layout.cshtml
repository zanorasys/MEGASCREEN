@using MegaScreen.Web.Data
@inject AppRepository Repository
@{
    var perfil = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Atendente";
    var nome = User.Identity?.Name ?? "Usuário";
    var iniciais = string.Concat(nome.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpper();
    string Active(string page) => (ViewContext.RouteData.Values["page"]?.ToString() ?? "").StartsWith(page + "/", StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var filialId = int.TryParse(User.FindFirst("FilialId")?.Value, out var f) ? f : 1;
    var filialNome = User.FindFirst("FilialNome")?.Value ?? "Filial";
    var localAtual = User.FindFirst("LocalAtual")?.Value ?? "Recepção I";
    var filiais = perfil == "Admin" ? await Repository.ListarFiliaisAtivasAsync() : new List<MegaScreen.Web.Models.Filial>();
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Mega Screen — @ViewData["Title"]</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<div class="app">
<aside class="side" id="side">
<div class="brand"><div class="mark"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="#fff" stroke-width="2.2"><rect x="4" y="4" width="16" height="12" rx="2"/><path d="M9 20h6M8 16v4M16 16v4"/></svg></div><div><h1>Mega Screen</h1><small>Backoffice</small></div></div>
@if(perfil=="Admin"){
<div class="filial"><button class="fbtn" type="button" onclick="this.parentElement.classList.toggle('open')"><span class="fdot"></span><div class="ftxt"><small>Filial ativa</small><b>@filialNome</b></div><span style="margin-left:auto">⌄</span></button><div class="fmenu">
@foreach(var filial in filiais){<form method="post" asp-page="/Account/SwitchFilial" asp-route-filialId="@filial.Id"><button class="@(filial.Id==filialId?"sel":"")" type="submit">@filial.Nome @if(filial.Id==filialId){<span class="chk">✓</span>}</button></form>}
</div></div>}
<nav class="nav">
<div class="nav-label">Operação</div><a class="@Active("/Painel")" asp-page="/Painel/Index">Painel</a><a class="@Active("/Telas")" asp-page="/Telas/Index">Telas</a>
<div class="nav-label">Configuração</div><a class="@Active("/SalasEspera")" asp-page="/SalasEspera/Index">Salas de Espera</a><a class="@Active("/Salas")" asp-page="/Salas/Index">Salas</a><a class="@Active("/Modalidades")" asp-page="/Modalidades/Index">Modalidades</a><a class="@Active("/Usuarios")" asp-page="/Usuarios/Index">Usuários</a>
<div class="nav-label">Sistema</div><a class="@Active("/Personalizacao")" asp-page="/Personalizacao/Index">Personalização</a><a class="@Active("/Ajuda")" asp-page="/Ajuda/Index">Ajuda</a>
@if(perfil=="Admin"){<div class="nav-label">ADMIN · White Label</div><a class="@Active("/Clientes")" asp-page="/Clientes/Index">Gestão de Clientes</a><a class="@Active("/Filiais")" asp-page="/Filiais/Index">Filiais</a>}
</nav>
<div class="foot"><a class="av" asp-page="/Account/Perfil" title="Meu perfil">@iniciais</a><div><b>@nome</b><small>@perfil · @filialNome</small></div><form asp-page="/Account/Logout" method="post" style="margin-left:auto"><button class="out" type="submit" title="Sair">↪</button></form></div>
</aside>
<div class="main">
<div class="topbar"><button class="burger" type="button" onclick="document.getElementById('side').classList.toggle('open')">☰</button><div class="pagetitle">@ViewData["Title"]<small>@filialNome · @localAtual</small></div><div class="spacer"></div>
<a class="btn line sm" asp-page="/Public/Tv" asp-route-filialId="@filialId" target="_blank">Ver painel (TV)</a>
@if(perfil is "Admin" or "Profissional"){<a class="btn line sm" asp-page="/Public/Profissional" target="_blank">Tela do profissional</a>}
<a class="btn line sm" asp-page="/Public/Totem" asp-route-filialId="@filialId" target="_blank">Totem</a>
<div class="clock"><span class="t" id="clock">--:--</span><span class="d" id="today"></span></div></div>
<main class="content"><div class="toasts" id="toasts"></div>@if(TempData["Toast"] is string toast){<div class="alert-ok">@toast</div>}@RenderBody()</main>
</div></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script src="~/js/mascaras.js" asp-append-version="true"></script>
<script>
(()=>{const TZ='America/Sao_Paulo';const tick=()=>{const d=new Date(),c=document.getElementById('clock'),t=document.getElementById('today');if(c)c.textContent=d.toLocaleTimeString('pt-BR',{timeZone:TZ,hour:'2-digit',minute:'2-digit'});if(t)t.textContent=d.toLocaleDateString('pt-BR',{timeZone:TZ,weekday:'long'});};tick();setInterval(tick,10000);document.addEventListener('click',e=>{document.querySelectorAll('.filial.open').forEach(x=>{if(!x.contains(e.target))x.classList.remove('open')})});})();
</script>
@await RenderSectionAsync("Scripts", required:false)
</body></html>