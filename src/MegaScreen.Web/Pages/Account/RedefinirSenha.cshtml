@page
@model MegaScreen.Web.Pages.Account.RedefinirSenhaModel
@{Layout=null;}
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css"/></head><body><div class="auth"><div class="brandside"><div class="logo"><div class="mark">MS</div><div><h1>Mega Screen</h1><small>Sistema de Senhas</small></div></div></div><div class="formside"><div class="fbox">@if(!Model.Valido){<h3>Link inválido ou expirado</h3><p class="lead">Solicite uma nova recuperação de senha.</p><a class="btn pri-btn block" asp-page="/Account/EsqueciSenha">Solicitar novo link</a>}else{<h3>Definir nova senha</h3><p class="lead">Escolha uma senha com pelo menos 8 caracteres.</p><form method="post"><input asp-for="Token" type="hidden"/><div asp-validation-summary="All" style="color:var(--red);margin-bottom:12px"></div><div class="field"><label>Nova senha</label><input asp-for="NovaSenha" type="password" autocomplete="new-password"/></div><div class="field"><label>Confirmar senha</label><input asp-for="Confirmacao" type="password" autocomplete="new-password"/></div><button class="btn pri-btn block">Redefinir senha</button></form>}</div></div></div></body></html>
