@page
@model MegaScreen.Web.Pages.Painel.IndexModel
@{ ViewData["Title"]="Painel"; var mins=TimeSpan.FromSeconds(Model.Stats.EsperaMediaSegundos); }
<div class="kpis">
<div class="kpi"><div class="kh"><span>Aguardando</span><div class="ki i-wait">◷</div></div><div class="kv" id="kWait">@Model.Stats.Aguardando</div></div>
<div class="kpi"><div class="kh"><span>Em atendimento</span><div class="ki i-att">●</div></div><div class="kv" id="kAtt">@Model.Stats.EmAtendimento</div></div>
<div class="kpi"><div class="kh"><span>Concluídos hoje</span><div class="ki i-done">✓</div></div><div class="kv" id="kDone">@Model.Stats.ConcluidosHoje</div></div>
<div class="kpi"><div class="kh"><span>Espera média</span><div class="ki i-time">⌛</div></div><div class="kv num" id="kTime">@($"{(int)mins.TotalMinutes:00}:{mins.Seconds:00}")</div></div>
</div>
<div class="grid">
<div class="stack"><div class="card"><div class="calling" id="calling"></div><div class="qtool"><div class="search"><input id="search" placeholder="Buscar por senha, nome ou modalidade"></div><button class="btn line sm" id="callNext">Chamar próxima</button><button class="btn pri-btn2 sm" id="addBtn">Adicionar manualmente</button></div><table><thead><tr><th>Ordem</th><th>Senha</th><th>Nome</th><th>Modalidade</th><th>Prioridade</th><th>Status</th><th></th></tr></thead><tbody id="queueBody"></tbody></table></div></div>
<div class="stack"><div class="card"><div class="card-head"><h2>Próximas chamadas</h2><span class="rt"><span class="dot"></span>Ao vivo</span></div><div class="next-list" id="nextList"></div></div>
<div class="card"><div class="card-head"><h2>Pontos de atendimento</h2><span class="sub">@Model.LocalAtual</span></div><div class="rooms">@foreach(var p in Model.Pontos){<div class="room"><span class="rdot" style="background:@(p.Ativo?"var(--green)":"var(--amber)")"></span><span class="rname">@p.Nome</span><span class="rstate @(p.Ativo?"free":"paused")">@(p.Ativo?"Ativo":"Pausado")</span></div>}</div></div></div>
</div>
<div class="overlay" id="overlay"><div class="modal"><div class="mhead"><h3>Adicionar senha manualmente</h3><button class="x" id="modalX" type="button">✕</button></div><div class="mbody"><div class="field"><label>Nome do paciente</label><input id="asNome" placeholder="Nome completo"></div><div class="field"><label>Modalidade</label><select id="asMod">@foreach(var m in Model.Modalidades){<option value="@m.Id">@m.Nome</option>}</select></div><div class="field"><label>Prioridade</label><div class="seg" id="asPri"><button class="on" data-p="1" type="button">Normal</button><button data-p="2" type="button">Idoso</button><button data-p="3" type="button">Prioridade</button></div></div></div><div class="mfoot"><button class="btn line" id="modalCancel" type="button">Cancelar</button><button class="btn pri-btn2" id="modalSave" type="button">Adicionar à fila</button></div></div></div>
<div class="overlay" id="printOverlay"><div class="modal" style="max-width:360px"><div class="mhead"><h3>Senha gerada</h3><button class="x" id="printX" type="button">✕</button></div><div class="mbody"><div class="cupom-wrap" id="cupomPreview"></div></div><div class="mfoot"><button class="btn line" id="printClose" type="button">Fechar</button><button class="btn pri-btn2" id="printNow" type="button">Imprimir senha</button></div></div></div>
<div id="cupomPrint"></div>
@section Scripts{
<script>window.MEGA={filialId:@Model.FilialId,localAtual:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LocalAtual)),fila:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Fila))};</script>
<script src="~/js/painel.js" asp-append-version="true"></script>
}