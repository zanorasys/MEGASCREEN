@page
@model MegaScreen.Web.Pages.Usuarios.IndexModel
@{ViewData["Title"]="Usuários";}
<div class="page-head"><div><h2>Usuários</h2><p>Usuários do backoffice e seus perfis.</p></div></div>
<div class="cfg-grid">
<div class="card"><div class="card-head"><h2>@(Model.Item.Id==0?"Novo usuário":"Editar usuário")</h2></div><form method="post" asp-page-handler="Save" class="form-pad">
<input asp-for="Item.Id" type="hidden"><div class="form2">
<div class="field"><label>Nome</label><input asp-for="Item.Nome"></div><div class="field"><label>E-mail</label><input asp-for="Item.Email" type="email"></div>
<div class="field"><label>Perfil</label><select asp-for="Item.Perfil" asp-items="Html.GetEnumSelectList<PerfilUsuario>()"></select></div>
<div class="field"><label>Local atual</label><input asp-for="Item.LocalAtual"></div>
<div class="field"><label>@(Model.Item.Id==0?"Senha inicial":"Nova senha (opcional)")</label><input asp-for="NovaSenha" type="password"></div>
<div class="field"><label class="check"><input asp-for="Item.Ativo"> Ativo</label></div></div>
<div asp-validation-summary="All" class="validation"></div><button class="btn pri-btn2">Salvar</button>@if(Model.Item.Id>0){<a class="btn line" asp-page="./Index">Cancelar</a>}</form></div>
<div class="card"><table><thead><tr><th>Nome</th><th>E-mail</th><th>Perfil</th><th>Local</th><th>Status</th><th></th></tr></thead><tbody>
@foreach(var u in Model.Itens){<tr><td class="nm">@u.Nome</td><td>@u.Email</td><td><span class="pri @(u.Perfil==PerfilUsuario.Admin?"alta":u.Perfil==PerfilUsuario.Atendente?"idoso":"normal")">@u.Perfil</span></td><td>@u.LocalAtual</td><td><span class="st @(u.Ativo?"on":"off")">@(u.Ativo?"Ativo":"Inativo")</span></td><td><div class="rowacts"><a class="iconbtn" asp-route-edit="@u.Id" title="Editar">✎</a><form method="post" asp-page-handler="Delete" asp-route-id="@u.Id"><button class="iconbtn" title="Desativar">×</button></form></div></td></tr>}
</tbody></table></div></div>