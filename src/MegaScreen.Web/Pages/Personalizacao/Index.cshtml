@page
@model MegaScreen.Web.Pages.Personalizacao.IndexModel
@{ViewData["Title"]="Personalização";}
<div class="page-head"><div><h2>Personalização (Aparência)</h2><p>Ajuste a identidade visual das telas públicas, como no protótipo.</p></div></div>
<form method="post" enctype="multipart/form-data">
<div asp-validation-summary="All" class="validation"></div>
<div class="cfg-grid">
<div class="stack">
<div class="card"><div class="card-head"><h2>Marca e cores</h2></div><div class="form-pad"><div class="field"><label>Nome da marca</label><input asp-for="Item.Marca"></div><div class="colorline"><span class="cn">Cor de fundo</span><span class="val">@Model.Item.CorFundo</span><input asp-for="Item.CorFundo" type="color"></div><div class="colorline"><span class="cn">Cor do texto</span><span class="val">@Model.Item.CorTexto</span><input asp-for="Item.CorTexto" type="color"></div><div class="colorline"><span class="cn">Cor de destaque</span><span class="val">@Model.Item.CorDestaque</span><input asp-for="Item.CorDestaque" type="color"></div><div class="field"><label>Fonte</label><select asp-for="Item.Fonte"><option>Manrope</option><option>Space Grotesk</option><option>Arial</option><option>Verdana</option></select></div></div></div>
<div class="card"><div class="card-head"><h2>Exibição</h2></div><div class="form-pad"><div class="toggle-row"><div class="tx">Mostrar horário<small>Relógio no topo do painel</small></div><div class="sw"><input asp-for="Item.MostrarHorario"><label asp-for="Item.MostrarHorario"></label></div></div><div class="toggle-row"><div class="tx">Número da chamada<small>Senha em destaque</small></div><div class="sw"><input asp-for="Item.MostrarNumero"><label asp-for="Item.MostrarNumero"></label></div></div><div class="toggle-row"><div class="tx">Ordem de chamada<small>Lista lateral</small></div><div class="sw"><input asp-for="Item.MostrarOrdem"><label asp-for="Item.MostrarOrdem"></label></div></div><div class="toggle-row"><div class="tx">Sala / guichê<small>Destino do atendimento</small></div><div class="sw"><input asp-for="Item.MostrarSala"><label asp-for="Item.MostrarSala"></label></div></div></div></div>
</div>
<div class="stack">
<div class="card"><div class="card-head"><h2>Arquivos</h2></div><div class="form-pad"><div class="field"><label>Logotipo</label><input asp-for="Logo" type="file" accept=".png,.jpg,.jpeg,.webp,.gif"><small class="hint">@Model.Item.LogoUrl</small></div><div class="field"><label>Imagem de fundo</label><input asp-for="Fundo" type="file" accept=".png,.jpg,.jpeg,.webp,.gif"><small class="hint">@Model.Item.FundoUrl</small></div><div class="field"><label>Vídeo / publicidade</label><input asp-for="Video" type="file" accept=".mp4,.webm,.ogg"><small class="hint">@Model.Item.VideoUrl</small></div></div></div>
<div class="card"><div class="card-head"><h2>Pré-visualização</h2></div><div class="form-pad"><div class="tvmini" style="background:@Model.Item.CorFundo;color:@Model.Item.CorTexto"><div class="bar" style="background:@Model.Item.CorDestaque">@Model.Item.Marca</div><div class="body"><div class="main"><div class="s">A046</div><div class="n">Lucas Ribeiro</div></div><div class="lst"><div><span>A045</span><span>Guichê 2</span></div><div><span>P012</span><span>Guichê 1</span></div></div></div></div></div></div>
</div></div><div style="margin-top:18px"><button class="btn pri-btn2">Salvar personalização</button></div></form>