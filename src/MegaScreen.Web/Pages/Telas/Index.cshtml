@page
@model MegaScreen.Web.Pages.Telas.IndexModel
@{
    ViewData["Title"] = "Telas";
    // Formulário começa recolhido; abre sozinho ao editar ou quando o POST volta com erro (mesmo padrão de Salas).
    var formAberto = Model.Item.Id > 0 || !ViewData.ModelState.IsValid || Request.Query.ContainsKey("novo");
}
<div class="page-head">
    <div><h2>Gerenciamento de Telas</h2><p>Telas de exibição associadas às salas de espera. Cada tela tem um link próprio: abra-o no navegador da TV ou do tablet.</p></div>
    <button type="button" class="btn pri-btn2 sm spacer" data-abre-form="formTela">+ Nova tela</button>
</div>
<div class="stack">
    <div class="card form-collapse @(formAberto ? "" : "hidden")" id="formTela" data-editando="@(Model.Item.Id > 0 ? "1" : "0")">
        <div class="card-head"><h2>@(Model.Item.Id == 0 ? "Nova tela" : "Editar tela")</h2></div>
        <form method="post" asp-page-handler="Save" class="form-pad">
            <input asp-for="Item.Id" type="hidden">
            <div class="form4">
                <div class="field"><label>Nome</label><input asp-for="Item.Nome" placeholder="Ex: Recepção Térreo"></div>
                <div class="field"><label>Apelido</label><input asp-for="Item.Apelido" placeholder="REC-T"></div>
                <div class="field"><label>Tipo de tela</label><select asp-for="Item.Tipo" asp-items="Html.GetEnumSelectList<TipoTela>()"></select></div>
                <div class="field"><label>Sala de espera</label><select asp-for="Item.SalaEsperaId"><option value="">Sem vínculo (filial inteira)</option>@foreach (var s in Model.SalasEspera) {<option value="@s.Id">@s.Nome</option>}</select></div>
                <div class="field"><label>Prédio</label><input asp-for="Item.Predio" placeholder="A"></div>
                <div class="field"><label>Andar</label><input asp-for="Item.Andar" placeholder="Térreo"></div>
                <div class="field"><label>Ramal</label><input asp-for="Item.Ramal" placeholder="201"></div>
                <div class="field"><label>Cor</label><input asp-for="Item.Cor" type="color"></div>
            </div>
            <label class="check"><input asp-for="Item.Visivel"> Visível (desmarcada, a tela mostra "desativada")</label>
            <div asp-validation-summary="All" class="validation"></div>
            <div class="form-acts">
                <button class="btn pri-btn2">Salvar</button>
                @if (Model.Item.Id > 0) {<a class="btn line" asp-page="./Index">Cancelar</a>}
                else {<button type="button" class="btn line" data-fecha-form="formTela">Cancelar</button>}
            </div>
        </form>
    </div>
    <div class="card"><div class="table-wrap"><table class="tbl-telas">
    <thead><tr><th>ID</th><th>Nome</th><th>Tipo</th><th>Localização</th><th>Sala de espera</th><th>Cor</th><th>Visível</th><th>Link</th><th></th></tr></thead>
    <tbody>
    @if (Model.Itens.Count == 0) {<tr class="empty-row"><td colspan="9">Nenhuma tela cadastrada. Clique em "+ Nova tela".</td></tr>}
    @foreach (var t in Model.Itens)
    {
        var tv = t.Tipo == TipoTela.TvHorizontal;
        var link = tv ? Url.Page("/Public/Tv", null, new { telaId = t.Id }, Request.Scheme) : Url.Page("/Public/Totem", null, new { telaId = t.Id }, Request.Scheme);
        <tr>
            <td class="ord">#@t.Id.ToString("D2")</td>
            <td class="nm">@t.Nome<br><small>@t.Apelido</small></td>
            <td><span class="badge-type @(tv ? "tv" : "tablet")">@(tv ? "TV Horizontal" : "Tablet Vertical")</span></td>
            <td>@string.Join(" · ", new[] { string.IsNullOrWhiteSpace(t.Predio) ? null : "Prédio " + t.Predio, t.Andar, string.IsNullOrWhiteSpace(t.Ramal) ? null : "R." + t.Ramal }.Where(x => !string.IsNullOrWhiteSpace(x)))</td>
            <td>@(t.SalaEspera?.Nome ?? "Filial inteira")</td>
            <td><span class="swatch" style="background:@t.Cor"></span></td>
            <td><span class="st @(t.Visivel ? "on" : "off")">@(t.Visivel ? "Visível" : "Oculta")</span></td>
            <td class="tel-link"><a href="@link" target="_blank">Abrir</a> · <a href="#" data-copy="@link">Copiar</a></td>
            <td><div class="rowacts"><a class="iconbtn" asp-route-edit="@t.Id" title="Editar">✎</a><form method="post" asp-page-handler="Delete" asp-route-id="@t.Id" onsubmit="return confirm('Excluir esta tela?')"><button class="iconbtn" title="Excluir">×</button></form></div></td>
        </tr>
    }
    </tbody></table></div></div>
</div>
@section Scripts {
<script src="~/js/form-collapse.js" asp-append-version="true"></script>
<script>
document.querySelectorAll('[data-copy]').forEach(a => a.onclick = async e => {
    e.preventDefault();
    try { await navigator.clipboard.writeText(a.dataset.copy); a.textContent = 'Copiado'; }
    catch { prompt('Copie o link:', a.dataset.copy); }
    setTimeout(() => a.textContent = 'Copiar', 1500);
});
</script>
}
