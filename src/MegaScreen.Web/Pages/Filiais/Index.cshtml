@page
@model MegaScreen.Web.Pages.Filiais.IndexModel
@{ViewData["Title"]="Filiais";}
<div class="page-head"><div><h2>Filiais</h2><p>Unidades vinculadas aos clientes White Label.</p></div></div>
<div class="cfg-grid"><div class="card"><div class="card-head"><h2>@(Model.Item.Id==0?"Nova filial":"Editar filial")</h2></div><form method="post" asp-page-handler="Save" class="form-pad"><input asp-for="Item.Id" type="hidden"><div class="field"><label>Cliente</label><select asp-for="Item.ClienteId"><option value="0">Selecione</option>@foreach(var c in Model.Clientes){<option value="@c.Id">@c.Nome</option>}</select></div><div class="field"><label>Nome da filial</label><input asp-for="Item.Nome"></div><div class="form2"><div class="field"><label>Cidade</label><input asp-for="Item.Cidade"></div><div class="field"><label>UF</label><input asp-for="Item.Uf" maxlength="2"></div></div><label class="check"><input asp-for="Item.ImpressoraHabilitada"> Integração com impressora habilitada</label><label class="check"><input asp-for="Item.Ativa"> Filial ativa</label><div asp-validation-summary="All" class="validation"></div><div style="margin-top:14px"><button class="btn pri-btn2">Salvar</button>@if(Model.Item.Id>0){<a class="btn line" asp-page="./Index">Cancelar</a>}</div></form></div>
<div class="card"><table><thead><tr><th>Filial</th><th>Cidade</th><th>Usuários</th><th>Telas</th><th>Impressora</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var f in Model.Itens){<tr><td class="nm">@f.Nome</td><td>@f.Cidade / @f.Uf</td><td>@f.Usuarios.Count</td><td>@f.Telas.Count</td><td>@(f.ImpressoraHabilitada?"Habilitada":"Não")</td><td><span class="st @(f.Ativa?"on":"off")">@(f.Ativa?"Ativa":"Inativa")</span></td><td><div class="rowacts"><a class="iconbtn" asp-route-edit="@f.Id">✎</a><form method="post" asp-page-handler="Delete" asp-route-id="@f.Id"><button class="iconbtn">×</button></form></div></td></tr>}</tbody></table></div></div>