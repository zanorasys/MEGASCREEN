@page
@model MegaScreen.Web.Pages.Filiais.IndexModel
@{ ViewData["Title"] = "Filiais"; }
<div class="page-head"><div><h2>Filiais <span class="pri alta">Multi-Filial</span></h2><p>Unidades do cliente, com usuários e rotinas específicas.</p></div><div class="spacer"></div><button class="btn pri-btn2">Nova filial</button></div>
<div class="card"><table><thead><tr><th>Filial</th><th>Cidade/UF</th><th>Usuários</th><th>Telas</th><th>Impressora</th><th>Status</th></tr></thead><tbody>
@foreach (var f in Model.Itens) { <tr><td class="nm">@f.Nome</td><td>@f.Cidade/@f.Uf</td><td>@f.Usuarios.Count</td><td>@f.Telas.Count</td><td><span class="st @(f.ImpressoraHabilitada ? "on" : "off")">@(f.ImpressoraHabilitada ? "Conectada" : "Sem impressora")</span></td><td><span class="st @(f.Ativa ? "on" : "off")">@(f.Ativa ? "Ativa" : "Inativa")</span></td></tr> }
</tbody></table></div>
